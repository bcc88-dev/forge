# CLIDE Configuration
# Copy this file to .env and fill in your keys.

# === Supabase (for persistent cloud memory) ===
# Get these from your Supabase project: Settings > API
SUPABASE_URL=https://bzfgbkhkjxspvonwxtku.supabase.co
# Anon key = read-only memory (recall works, store is local-only)
SUPABASE_ANON_KEY=
# Service role key = full read/write cloud memory
SUPABASE_SERVICE_KEY=

# === API Providers (default: Ollama local — no key needed) ===
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# === Stripe (for billing — optional for local dev) ===
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# === Ollama (optional — default http://localhost:11434) ===
OLLAMA_BASE_URL=
